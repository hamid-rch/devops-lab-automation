
services:
  minio:
    image: "{{ minio_image }}"
    container_name: minio
    hostname: "{{ inventory_hostname }}"
    restart: unless-stopped

    ports:
      - "{{ minio_api_bind_ip }}:{{ minio_api_port }}:{{ minio_container_api_port }}"
      - "{{ minio_api_bind_ip }}:{{ minio_console_port }}:{{ minio_container_console_port }}"

    extra_hosts:
{% for node in groups[minio_node_group] %}
      - "{{ node }}:{{ hostvars[node].ansible_host | default(node) }}"
{% endfor %}

    environment:
      MINIO_ROOT_USER: "{{ minio_root_user }}"
      MINIO_ROOT_PASSWORD: "{{ minio_root_password }}"
      MINIO_BROWSER_REDIRECT_URL: "{{ minio_browser_redirect_url }}"

    command:
      - server
      - "http://minio{1...4}/data{1...2}"
      - --console-address
      - "{{ minio_server_console_address }}"

    volumes:
{% for drive in minio_data_drives %}
      - "{{ drive.mount_path }}:{{ drive.container_path }}"
{% endfor %}

    networks:
      - minio_network

{% if inventory_hostname == minio_primary_node %}
  traefik:
    image: "{{ minio_traefik_image }}"
    container_name: minio-traefik
    restart: unless-stopped

    ports:
      - "{{ minio_traefik_port }}:{{ minio_traefik_container_port }}"

    volumes:
      - "{{ minio_stack_dir }}/traefik.yml:/etc/traefik/traefik.yml:ro"
      - "{{ minio_stack_dir }}/dynamic.yml:/etc/traefik/dynamic.yml:ro"

    depends_on:
      - minio

    networks:
      - minio_network
{% endif %}

networks:
  minio_network:
    driver: bridge
