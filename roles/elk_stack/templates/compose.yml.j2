services:
  elasticsearch:
    image: "{{ elasticsearch_image }}"
    container_name: "{{ es_container_name }}"
    restart: unless-stopped
    environment:
      discovery.type: single-node
      xpack.security.enabled: "true"
      xpack.security.http.ssl.enabled: "false"
      xpack.security.transport.ssl.enabled: "false"
      ELASTIC_PASSWORD: {{ elastic_password | to_json }}
      ES_JAVA_OPTS: "-Xms{{ elasticsearch_heap }} -Xmx{{ elasticsearch_heap }}"
    ports:
      - "{{ elasticsearch_publish_address }}:{{ elasticsearch_host_port }}:9200"
    volumes:
      - esdata:/usr/share/elasticsearch/data
    networks:
      - elk
    healthcheck:
      test: ["CMD-SHELL", "curl -s -o /dev/null -w '%{http_code}' http://localhost:9200 | grep -Eq '200|401'"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 30s

  logstash:
    image: "{{ logstash_image }}"
    container_name: logstash
    restart: unless-stopped
    depends_on:
      elasticsearch:
        condition: service_healthy
    environment:
      LS_JAVA_OPTS: "-Xms{{ logstash_heap }} -Xmx{{ logstash_heap }}"
      ELASTIC_PASSWORD: {{ elastic_password | to_json }}
    ports:
      - "{{ logstash_beats_host_port }}:5044"
      - "127.0.0.1:9600:9600"
    volumes:
      - "{{ logstash_pipeline_dir }}:/usr/share/logstash/pipeline:ro"
    networks:
      - elk

  kibana:
    image: "{{ kibana_image }}"
    container_name: "{{ kibana_container_name }}"
    restart: unless-stopped
    depends_on:
      elasticsearch:
        condition: service_healthy
    environment:
      ELASTICSEARCH_HOSTS: '["{{ es_in_kibana_url }}"]'
      ELASTICSEARCH_SERVICEACCOUNTTOKEN: {{ kibana_token | default('') | to_json }}
      XPACK_FLEET_REGISTRYURL: "{{ package_registry_url }}"
    ports:
      - "{{ kibana_publish_address }}:{{ kibana_host_port }}:5601"
    volumes:
      - "{{ kibana_config_local_path }}:/usr/share/kibana/config/kibana.yml:ro"
    networks:
      - elk
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost:5601/api/status >/dev/null"]
      interval: 15s
      timeout: 5s
      retries: 40
      start_period: 60s

  package-registry:
    image: "{{ package_registry_image }}"
    container_name: package-registry
    restart: unless-stopped
    networks:
      - elk

  fleet-server-a:
    image: "{{ elastic_agent_image }}"
    container_name: fleet-server-a
    restart: unless-stopped
    depends_on:
      elasticsearch:
        condition: service_healthy
      kibana:
        condition: service_healthy
    environment:
      FLEET_SERVER_ENABLE: "1"
      FLEET_SERVER_ELASTICSEARCH_HOST: "http://elasticsearch:9200"
      FLEET_SERVER_SERVICE_TOKEN: {{ compose_fleet_server_token | default('') | to_json }}
      FLEET_SERVER_POLICY_ID: "{{ fleet_server_policy_id }}"
      FLEET_SERVER_HOST: "0.0.0.0"
      FLEET_SERVER_PORT: "8220"
      FLEET_SERVER_INSECURE_HTTP: "true"
      STATE_PATH: "/state"
    volumes:
      - "{{ fleet_state_dir }}/fleet-server-a:/state"
    networks:
      - elk

  fleet-server-b:
    image: "{{ elastic_agent_image }}"
    container_name: fleet-server-b
    restart: unless-stopped
    depends_on:
      elasticsearch:
        condition: service_healthy
      kibana:
        condition: service_healthy
    environment:
      FLEET_SERVER_ENABLE: "1"
      FLEET_SERVER_ELASTICSEARCH_HOST: "http://elasticsearch:9200"
      FLEET_SERVER_SERVICE_TOKEN: {{ compose_fleet_server_token | default('') | to_json }}
      FLEET_SERVER_POLICY_ID: "{{ fleet_server_policy_id }}"
      FLEET_SERVER_HOST: "0.0.0.0"
      FLEET_SERVER_PORT: "8220"
      FLEET_SERVER_INSECURE_HTTP: "true"
      STATE_PATH: "/state"
    volumes:
      - "{{ fleet_state_dir }}/fleet-server-b:/state"
    networks:
      - elk

  traefik:
    image: "{{ traefik_image }}"
    container_name: traefik
    restart: unless-stopped
    command:
      - "--providers.file.filename=/etc/traefik/dynamic.yml"
      - "--providers.file.watch=true"
      - "--entrypoints.fleet.address=:8220"
      - "--entrypoints.web.address=:80"
      - "--log.level=INFO"
    ports:
      - "{{ fleet_load_balancer_host_port }}:8220"
    volumes:
      - "{{ elk_compose_dir }}/traefik/dynamic.yml:/etc/traefik/dynamic.yml:ro"
    networks:
      - elk
    depends_on:
      - fleet-server-a
      - fleet-server-b

volumes:
  esdata:

networks:
  elk:
    name: elk
    driver: bridge
