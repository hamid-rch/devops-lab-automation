global:
  scrape_interval: "{{ monitoring_scrape_interval }}"

rule_files:
  - "/etc/prometheus/rules/*.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:9093"

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["prometheus:9090"]
    basic_auth:
      username: "{{ vault_monitoring_basic_auth_username }}"
      password: "{{ vault_monitoring_basic_auth_password }}"

  - job_name: node_exporter_metrics
    scrape_interval: 5s
    static_configs:
      - targets: ["{{ monitoring_node_exporter_target }}"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]
    basic_auth:
      username: "{{ vault_monitoring_alertmanager_username }}"
      password: "{{ vault_monitoring_alertmanager_password }}"
